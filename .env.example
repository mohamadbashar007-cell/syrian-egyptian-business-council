# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Contact form SMTP (configure these as server-side secrets in your hosting platform).
SMTP_HOST="mail.zaman-eg.com"
SMTP_PORT="465"
SMTP_USER="contact@zaman-eg.com"
SMTP_PASS="REPLACE_WITH_SECRET"
SMTP_FROM="contact@zaman-eg.com"
CONTACT_TO="segybc@gmail.com"

# Private news administration (server-side only; never prefix these with VITE_).
ADMIN_PASSWORD_HASH="scrypt$REPLACE_WITH_SALT$REPLACE_WITH_HASH"
ADMIN_SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# Local production server.
HOST="0.0.0.0"
PORT="8080"
CONTENT_STORAGE_DIR="storage"
